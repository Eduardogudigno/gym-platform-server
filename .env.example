NODE_ENV=development
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=false

# Comma-separated origins. The React app lives on another origin.
CORS_ORIGIN=http://localhost:5173

DB_HOST=localhost
DB_PORT=3306
DB_NAME=gym
DB_USER=gym
DB_PASSWORD=gym

JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=10

DEFAULT_CURRENCY=USD
BUSINESS_TIMEZONE=UTC
SUBSCRIPTION_PENDING_TTL_HOURS=72
REMINDER_DAYS=7,3,1

ENABLE_CRON=true
CRON_SCHEDULE=*/15 * * * *

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30

SEED_ADMIN_EMAIL=admin@gym.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_FIRST_NAME=System
SEED_ADMIN_LAST_NAME=Admin
SEED_DEMO_PASSWORD=ChangeMe123!

# manual records payments in the API. stripe is a prepared adapter.
PAYMENT_GATEWAY=manual
WEBHOOK_SECRET=change-me-webhook-secret
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
